# Python build/cache artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Generation / smoke-test run artifacts (logs + done markers).
# Keep the _run_*.sh / _setup_env.sh wrappers themselves — they have
# distinct suffixes and are not matched by these patterns.
*.log
*.done
*.tmp
*.out
*.err

# arch-implement skill scratch directories
arch_impl/

# Legacy llama_sc — pre-merge forked HF modeling file, kept locally as a
# reference / fallback while we validate the new adapter (model/llama_sc.py
# + model/sc_common.py). Do not commit.
model/llama_sc_legacy.py

# Benchmark downloaded data + run artifacts. Re-fetch with the
# download_paulgraham_essay.py / download_qa_dataset.sh scripts.
benchmark/ruler/data/synthetic/json/*.json
benchmark/ruler/ruler_eval_result
benchmark/ruler/_sbatch_logs/
benchmark/LongBench/results

# MP calibration / sweep artifacts (regenerable). Tables, sweep output dirs,
# and SmoothQuant scales are all reproduced by tests/run_mp_sweep.sh /
# tests/reproduce_crosslayer.sh — never commit them.
benchmark/ppl/mp_calib/
benchmark/ppl/_mp_overnight_*/
benchmark/ppl/_overnight_*/
benchmark/ppl/_mp_overnight_latest.path
benchmark/ppl/act_scales_*.pt

# Editor / OS
.vscode/
.idea/
.DS_Store
benchmark/ppl/_alpha_sweep_*/
benchmark/ppl/_halved_fix_*/

# hpca runtime artifacts (results live on Turbo; these are local eval caches)
benchmark/LongBench/results
benchmark/ruler/ruler_eval_result
