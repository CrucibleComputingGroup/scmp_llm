#!/bin/bash
# hpca — single entry point for the HPCA LLM experiments.
#
# PHASE 1: NON-SC quantization baselines.
#   models  : Qwen3-4B, Qwen3-14B, Qwen3-30B-A3B (MoE), Llama-3.1-8B
#   configs : fp16 + {W8A8,W7A7,W6A6,W5A5,W4A4} x {symm,asymm}   (11 per model)
#   quant   : SmoothQuant + chunked W/A RTN fake-quant for Linear layers, plus
#             QK/AV attention operand fake-quant. See benchmark/quant/ptq.py.
#   metrics : ppl (wikitext-2) + longbench + ruler
#
# PHASE 2: SC UNIFORM baselines (sc_int8, sc_avg192, sc_int7, sc_avg96, sc_int6).
#   One global stream length per cell — no mixed precision. All cells:
#   sc_prec=8, bipolar, halve optimization ON (tag value IS the cycle count:
#   128/96/64/48/32), Owen scramble bitrev with 64 masks, SmoothQuant with the
#   SAME cached act_scales as the INT cells. PPL runs through the IDENTICAL
#   eval_quant.py protocol (full wikitext-2 test, ctx 2048, GPTQ stream).
#   SC cells are ppl-only: longbench/ruler are skipped (SC decode is ~1.5 s/tok).
#   NOTE: SC forwards are ~2 orders of magnitude slower than fp16 — run SC
#   cells on their own GPU (e.g. --configs sc_int7 --metrics ppl) and expect
#   hours-to-a-day per (model, cell) on the big models.
#
# Each (model, config, metric) is one job. Results append to
#   benchmark/quant/_hpca_<tag>/results.tsv   (model \t config \t metric \t value)
# and the summary table prints at the end (also: tools re-parse the tsv).
#
# Usage:
#   bash hpca                                   # everything, this GPU
#   bash hpca --metrics ppl                     # PPL only (fast first pass)
#   bash hpca --models 1.7B,llama8B --metrics ppl,longbench
#   bash hpca --configs fp16,W8A8_symm,W4A4_asymm
#   bash hpca --gpu 0 --models 14B  &  bash hpca --gpu 1 --models 30B   # fan out
#   bash hpca --configs sc_int8,sc_int7,sc_int6 --metrics ppl   # SC uniform cells
#   bash hpca --configs mp_avg96_burst128,mp_avg64_burst128,mp_avg48_burst128 --metrics ppl \
#     --sc-backend hybrid --hybrid-sensitivity-config sc_int8
#   bash hpca --sensitivity --models 4B --configs sc_avg192     # ΔLoss sensitivity JSON
#   bash hpca --configs sc_avg192 --sc-backend hybrid --hybrid-config path.json
#   bash hpca --configs sc_avg192 --sc-backend hybrid            # auto top-10% INT from sensitivity JSON
#   bash hpca --dry-run                          # print jobs, run nothing
# -----------------------------------------------------------------------------
set -uo pipefail

MODELS_CSV="4B,14B,30B,llama8B"
CONFIGS_CSV="fp16,W8A8_symm,W8A8_asymm,W7A7_symm,W7A7_asymm,W6A6_symm,W6A6_asymm,W5A5_symm,W5A5_asymm,W4A4_symm,W4A4_asymm,sc_int8,sc_avg192,sc_int7,sc_avg96,sc_int6"
# SC scramble operating point (Phase 2 cells; ignored by INT cells).
# HARD-ASSIGNED, not inherited: a stale shell export (SC_SCRAMBLE_MASKS=256
# for pre-2026-06-03 tables, SC_OWEN_MODE=random for grad_sc calibration)
# would silently shift every SC cell to a different operating point that is
# invisible in results.tsv. Override only via --owen-mode / --masks.
SC_OWEN_MODE="bitrev"
SC_SCRAMBLE_MASKS="64"
METRICS_CSV="ppl,longbench,ruler"
TAG="$(date +%Y%m%d 2>/dev/null || echo run)"
CONDA_ENV="annstention"
HF_HOME_OVERRIDE="/nfs/turbo/coe-nbleier/allenjin/hf_cache"
# Storage tiers: weights + act_scales + final results -> Turbo (persistent);
# bulky per-cell logs -> scratch (write-heavy, ~60d purge). LongBench/RULER
# output dirs are symlinked to scratch already.
TURBO_BASE="/nfs/turbo/coe-nbleier/allenjin/hpca"
SCRATCH_BASE="/scratch/nbleier_owned_root/nbleier_owned1/shared_data/allenjin/hpca"
PPL_MAX_TOKENS=0   # 0 = full wikitext-2 test (BitMoD/GPTQ protocol); 65536 for quick smoke
PPL_CTX=2048
SQ_ALPHA=0.5
GPU_OVERRIDE=""
DRY=0
SC_BACKEND="sc"          # sc | hybrid
HYBRID_CONFIG_JSON=""
HYBRID_INT_BITS=""       # empty => derived from the config budget (iso-precision)
HYBRID_INT_BITS_MODE="isoprec"  # isoprec | legacy (pre-2026-07-21 hand table)
PRINT_INT_BITS_CYCLES=""
HYBRID_INT_FRAC="0.10"   # auto hybrid schedule: fraction of (op,block) entries switched to INT
HYBRID_SENS_DIR=""       # empty => $TURBO_BASE/sensitivity/_hpca_${TAG}
HYBRID_SENS_CONFIG=""    # empty => same as evaluated config; e.g. sc_avg192 to reuse one ranking
SENSITIVITY=0
SENS_METHOD="measured_curve"
SENS_CALIB_SEQS=4
SENS_CTX=512
SENS_WINDOWS=2
SENS_LAYER_BUCKETS="4"   # integer, or "layers"/"auto" for per-operator per-layer sensitivity
SENS_OUTDIR=""
INT_SWAP_REF="uniform"   # int_swap reference: uniform | mp_config
INT_SWAP_REF_LEVEL=""    # empty => min(mp_levels), the deployed floor
INT_SWAP_MP_CONFIG=""    # V9 wrapper JSON, required when INT_SWAP_REF=mp_config
INT_SWAP_WINDOW_SAMPLING="prefix"  # prefix (v18) | stratified (robust)
INT_SWAP_SCORE="mean"              # mean (v18) | lcb (uncertainty-aware)
INT_SWAP_LCB_Z="1.0"
INT_SWAP_STABILITY_FOLDS="2"
INT_SWAP_CHECKPOINT=""
MP_METHOD="act_global"        # currently supported in hpca: act_global
MP_TABLES_DIR=""              # empty => $TURBO_BASE/mp_calib_${TAG}
MP_PROTECT_FRAC="0.01"        # protected input channels inside remaining SC linears
MP_PROTECT_FRAC_OVERRIDES=""  # per-op frac overrides, e.g. "down_proj:0.05,up_proj:0.03"
SQ_ALPHA_OVERRIDES=""         # per-op SmoothQuant alpha, e.g. "down_proj:0.75,up_proj:0.65"
                              # (MP cells only; resolved inside apply_smoothquant_to_model
                              # so calib and eval geometry match by construction)
MP_SEED=0                     # calibrator --seed (torch + row-subsample RNG); vary for
                              # replication error bars. Eval is deterministic given the table.
# Empty means recipe default: 128 for legacy methods, 112 for v9.
MP_PROTECT_STOC_LEN=""
MP_PROTECT_METRIC="act_weight"
MP_PROTECT_COMPENSATE=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --models)   MODELS_CSV="$2"; shift 2 ;;
    --configs)  CONFIGS_CSV="$2"; shift 2 ;;
    --metrics)  METRICS_CSV="$2"; shift 2 ;;
    --tag)      TAG="$2"; shift 2 ;;
    --env)      CONDA_ENV="$2"; shift 2 ;;
    --hf-cache) HF_HOME_OVERRIDE="$2"; shift 2 ;;
    --max-tokens) PPL_MAX_TOKENS="$2"; shift 2 ;;
    --ctx)      PPL_CTX="$2"; shift 2 ;;
    --sq-alpha) SQ_ALPHA="$2"; shift 2 ;;
    --gpu)      GPU_OVERRIDE="$2"; shift 2 ;;
    --owen-mode) SC_OWEN_MODE="$2"; shift 2 ;;
    --masks)    SC_SCRAMBLE_MASKS="$2"; shift 2 ;;
    --sc-backend) SC_BACKEND="$2"; shift 2 ;;
    --hybrid-config) HYBRID_CONFIG_JSON="$2"; shift 2 ;;
    --hybrid-int-bits) HYBRID_INT_BITS="$2"; shift 2 ;;
    --hybrid-int-bits-mode) HYBRID_INT_BITS_MODE="$2"; shift 2 ;;
    --print-int-bits) PRINT_INT_BITS="$2"; shift 2 ;;
    --print-int-bits-cycles) PRINT_INT_BITS_CYCLES="$2"; shift 2 ;;
    --hybrid-int-frac) HYBRID_INT_FRAC="$2"; shift 2 ;;
    --hybrid-sensitivity-dir) HYBRID_SENS_DIR="$2"; shift 2 ;;
    --hybrid-sensitivity-config) HYBRID_SENS_CONFIG="$2"; shift 2 ;;
    --sensitivity) SENSITIVITY=1; METRICS_CSV="sensitivity"; shift ;;
    --sens-method) SENS_METHOD="$2"; shift 2 ;;
    --sens-calib-seqs) SENS_CALIB_SEQS="$2"; shift 2 ;;
    --sens-ctx) SENS_CTX="$2"; shift 2 ;;
    --sens-windows) SENS_WINDOWS="$2"; shift 2 ;;
    --sens-layer-buckets) SENS_LAYER_BUCKETS="$2"; shift 2 ;;
    --sens-outdir) SENS_OUTDIR="$2"; shift 2 ;;
    --int-swap-ref) INT_SWAP_REF="$2"; shift 2 ;;
    --int-swap-ref-level) INT_SWAP_REF_LEVEL="$2"; shift 2 ;;
    --int-swap-mp-config) INT_SWAP_MP_CONFIG="$2"; shift 2 ;;
    --int-swap-window-sampling) INT_SWAP_WINDOW_SAMPLING="$2"; shift 2 ;;
    --int-swap-score) INT_SWAP_SCORE="$2"; shift 2 ;;
    --int-swap-lcb-z) INT_SWAP_LCB_Z="$2"; shift 2 ;;
    --int-swap-stability-folds) INT_SWAP_STABILITY_FOLDS="$2"; shift 2 ;;
    --int-swap-checkpoint) INT_SWAP_CHECKPOINT="$2"; shift 2 ;;
    --mp-method) MP_METHOD="$2"; shift 2 ;;
    --mp-tables-dir) MP_TABLES_DIR="$2"; shift 2 ;;
    --mp-protect-frac) MP_PROTECT_FRAC="$2"; shift 2 ;;
    --mp-protect-frac-overrides) MP_PROTECT_FRAC_OVERRIDES="$2"; shift 2 ;;
    --sq-alpha-overrides) SQ_ALPHA_OVERRIDES="$2"; shift 2 ;;
    --mp-seed) MP_SEED="$2"; shift 2 ;;
    --mp-protect-stoc-len) MP_PROTECT_STOC_LEN="$2"; shift 2 ;;
    --mp-protect-metric) MP_PROTECT_METRIC="$2"; shift 2 ;;
    --mp-no-protect-compensate) MP_PROTECT_COMPENSATE=0; shift ;;
    --dry-run)  DRY=1; shift ;;
    -h|--help)  grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown flag: $1"; exit 1 ;;
  esac
done

# Width diagnostics are read-only queries.  Skip environment activation and
# run-directory creation even when the caller did not also pass --dry-run.
if [[ -n "${PRINT_INT_BITS:-}" || -n "$PRINT_INT_BITS_CYCLES" ]]; then
  DRY=1
fi

case "$SC_BACKEND" in
  sc|hybrid) ;;
  *) echo "unknown --sc-backend: $SC_BACKEND (expected sc|hybrid)"; exit 1 ;;
esac
case "$SENS_METHOD" in
  measured|measured_marg|measured_curve|int_swap) ;;
  *) echo "unknown --sens-method: $SENS_METHOD"; exit 1 ;;
esac
case "$INT_SWAP_WINDOW_SAMPLING" in
  prefix|stratified) ;;
  *) echo "unknown --int-swap-window-sampling: $INT_SWAP_WINDOW_SAMPLING (expected prefix|stratified)"; exit 1 ;;
esac
case "$INT_SWAP_SCORE" in
  mean|lcb) ;;
  *) echo "unknown --int-swap-score: $INT_SWAP_SCORE (expected mean|lcb)"; exit 1 ;;
esac
case "$HYBRID_INT_BITS_MODE" in
  isoprec|legacy) ;;
  *) echo "unknown --hybrid-int-bits-mode: $HYBRID_INT_BITS_MODE (expected isoprec|legacy)"; exit 1 ;;
esac
case "$MP_METHOD" in
  act_global) ;;
  # act_global_v2 = act_global + KKT-consistent argmin pricing (mac_per_row,
  # not rep_g) + per-operator signed rho-selected dispatch metric.
  act_global_v2) ;;
  # act_global_v3 = v2 + MAC-consistent residual greedy fill (--refine sigma).
  # Pair with --mp-protect-metric act_collapse + the fine-ladder configs
  # (mp_avg48f/mp_avg64f/mp_avg32) for the full v3 recipe.
  act_global_v3) ;;
  # act_global_v3m = v3 + measured dLoss cross-layer weight W_g (documented
  # llama8B-specific edge: loss-aware W_g beat plain sigma only on llama8B).
  act_global_v3m) ;;
  # act_global_v3s = v3 + squared-error objective (--objective sigma2). Per-ROW
  # cliff-AWARE surrogate: the superlinear penalty ~ propagated loss makes the
  # allocator reluctant to push rows deep sub-cliff (fixes v4's cliff-blindness)
  # WITHOUT abandoning the per-row story. Runtime-free (calibration-only).
  act_global_v3s) ;;
  # act_global_v3c = v3 + measured per-level dLoss CURVE (--cross-layer-weight
  # measured_curve): the TRUE loss-aware objective, allocated per (op,layer-
  # bucket) group (curve is constant across a group's rows -> per-group uniform,
  # so this trades the per-row story for measured cliff-awareness). Runtime-free
  # (extra OFFLINE knock-down forwards only; curve auto-enables its budget fill).
  act_global_v3c) ;;
  # act_global_v9 = v3 mechanics + delta-sigma-squared objective. Intended
  # only for the int6-specific mp_avg32_v9 ladder (96..16 with a 24 bridge).
  act_global_v9) ;;
  *) echo "unknown --mp-method: $MP_METHOD (currently supported: act_global, act_global_v2, act_global_v3, act_global_v3m, act_global_v3s, act_global_v3c, act_global_v9)"; exit 1 ;;
esac

if [[ -z "$MP_PROTECT_STOC_LEN" ]]; then
  if [[ "$MP_METHOD" == "act_global_v9" ]]; then
    MP_PROTECT_STOC_LEN="112"
  else
    MP_PROTECT_STOC_LEN="128"
  fi
elif [[ "$MP_METHOD" == "act_global_v9" && "$MP_PROTECT_STOC_LEN" != "112" ]]; then
  echo "act_global_v9 fixes protected channels at 112 cycles; got --mp-protect-stoc-len $MP_PROTECT_STOC_LEN"
  exit 1
fi

# model shortname -> HF id
declare -A MODEL_ID=(
  [1.7B]="Qwen/Qwen3-1.7B"
  [4B]="Qwen/Qwen3-4B-Instruct-2507"
  [14B]="Qwen/Qwen3-14B"
  [30B]="Qwen/Qwen3-30B-A3B-Instruct-2507"
  [llama8B]="meta-llama/Llama-3.1-8B-Instruct"
)

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUTDIR="$SCRATCH_BASE/logs/_hpca_${TAG}"       # per-cell logs -> scratch
RESULTS="$TURBO_BASE/results/results_${TAG}.tsv"  # deliverable -> Turbo (persistent)
export ACT_SCALES_DIR="$TURBO_BASE/act_scales"    # calibration -> Turbo (reused)

if [[ -n "$GPU_OVERRIDE" ]]; then export CUDA_VISIBLE_DEVICES="$GPU_OVERRIDE"; fi

if [[ $DRY -eq 0 ]]; then
  set +u; source ~/.bashrc; conda activate "$CONDA_ENV"; set -u
  mkdir -p "$OUTDIR" "$TURBO_BASE/results" "$ACT_SCALES_DIR"
  # noclobber: parallel fan-out launches share one results file — a plain
  # check-then-write would let the second launch truncate the first's rows.
  ( set -o noclobber; printf "model\tconfig\tmetric\tvalue\n" > "$RESULTS" ) 2>/dev/null || true
fi
export HF_HOME="$HF_HOME_OVERRIDE"
export TRANSFORMERS_CACHE="$HF_HOME"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HF_HUB_CACHE="$HF_HOME/hub"
# Reduce allocator fragmentation on the big MoE (helps the 60GB model + quant).
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
if [[ $DRY -eq 0 ]]; then
  mkdir -p "$SCRATCH_BASE/tmp" 2>/dev/null || true
  export TMPDIR="$SCRATCH_BASE/tmp"
fi

IFS=, read -ra MODELS  <<<"$MODELS_CSV"
IFS=, read -ra CONFIGS <<<"$CONFIGS_CSV"
IFS=, read -ra METRICS <<<"$METRICS_CSV"

# Width diagnostics are pure queries; keep stdout parseable.
if [[ -z "${PRINT_INT_BITS:-}" && -z "$PRINT_INT_BITS_CYCLES" ]]; then
  echo "[hpca] outdir=$OUTDIR"
  echo "[hpca] models=$MODELS_CSV configs=$CONFIGS_CSV metrics=$METRICS_CSV"
  if [[ -n "$HYBRID_CONFIG_JSON" ]]; then
    echo "[hpca] sc_backend=$SC_BACKEND hybrid_config=$HYBRID_CONFIG_JSON"
  else
    echo "[hpca] sc_backend=$SC_BACKEND hybrid_int_frac=$HYBRID_INT_FRAC"
  fi
fi

record() {  # <model> <config> <metric> <value>
  printf "%s\t%s\t%s\t%s\n" "$1" "$2" "$3" "$4" >> "$RESULTS"
}

# Cells that crash or produce no parsable result are recorded as FAILED(...)
# rows and counted here; the script exits nonzero if any cell failed. Without
# this, a dead cell (OOM, missing act_scales, CUDA error) leaves no tsv row at
# all and the run still reports success — day-long SC cells must not vanish.
N_FAILED=0
fail_cell() {  # <model> <config> <metric> <why>
  echo "[hpca] !!! FAILED $1/$2/$3 ($4)"
  record "$1" "$2" "$3" "FAILED($4)"
  N_FAILED=$((N_FAILED + 1))
}

is_sc_like_cfg() {
  local cfg="$1"
  [[ "$cfg" == sc_* || "$cfg" == mp || "$cfg" == mp_* ]]
}

# Legacy hand-maintained width table. Kept ONLY so pre-2026-07-21 tags stay
# reproducible via --hybrid-int-bits-mode legacy. It disagreed with the
# iso-precision comparator map (sc_cycles_for_cfg) on the low-budget configs:
# mp_avg32_v9 and mp_avg32_burst128 masked at int7 while their budget is
# compared against int6, and mp_avg96f_burst128 masked at int7 while avg96 is
# compared against int8. Every avg32 cell of the 2026-07-18 dose wave ran int7
# for this reason. Do not extend this table; add configs to mp_budget_for_cfg.
hybrid_int_bits_legacy_for_cfg() {  # <config>
  case "$1" in
    sc_int8|sc_avg192|mp_avg192|mp_len192|mp_avg96_burst128) echo 8 ;;
    sc_int7|sc_avg96|mp_int7|mp_avg96|mp_len96|mp_len96_burst|mp_avg64_burst128|mp_avg48_burst128|mp_avg64f_burst128|mp_avg48f_burst128|mp_avg32_burst128|mp_avg32_v9|mp_avg36_v9|mp_avg40_v9|mp_avg64x_burst128|mp_avg48x_burst128|mp) echo 7 ;;
    sc_int6) echo 6 ;;
    *) echo 7 ;;
  esac
}

# Target average SC cycles (HALVED space) for a config = budget_ratio x ref.
cfg_avg_cycles() {  # <config> -> rounded halved cycles, or nonzero rc
  local spec levels ratio ref
  spec="$(mp_budget_for_cfg "$1" 2>/dev/null)" \
    || spec="$(sensitivity_budget_for_cfg "$1" 2>/dev/null)" \
    || return 1
  read -r levels ratio ref <<<"$spec"
  awk -v r="$ratio" -v f="$ref" 'BEGIN{printf "%d", int(r*f+0.5)}'
}

# Iso-precision INT width for a budget of <avg> HALVED cycles.
# An SC stream of NOMINAL length N resolves log2(N) levels and nominal = 2*avg,
# so the matching INT width is ceil(log2(2*avg)). This reproduces the
# comparator map in sc_cycles_for_cfg EXACTLY --
#   halved 128 / 96 / 64 / 48 / 32  ->  int 8 / 8 / 7 / 7 / 6
# -- which is the correspondence every iso-precision claim in the paper
# assumes. Deriving it means a new budget config cannot silently mask at a
# width its own comparator does not use.
iso_int_bits_for_cycles() {  # <halved avg cycles> -> bits
  local avg="$1" nominal bits=2
  nominal=$(( 2 * avg ))
  while (( (1 << bits) < nominal && bits < 8 )); do bits=$((bits + 1)); done
  echo "$bits"
}

hybrid_int_bits_for_cfg() {  # <config>
  local cfg="$1" avg bits
  # Explicit --hybrid-int-bits always wins (how a wave pins a width that is
  # deliberately NOT iso-precision, e.g. to stay comparable with older cells).
  if [[ -n "$HYBRID_INT_BITS" ]]; then echo "$HYBRID_INT_BITS"; return; fi
  if [[ "$HYBRID_INT_BITS_MODE" == "legacy" ]]; then
    hybrid_int_bits_legacy_for_cfg "$cfg"; return
  fi
  if avg="$(cfg_avg_cycles "$cfg")" && [[ -n "$avg" ]] && (( avg > 0 )); then
    bits="$(iso_int_bits_for_cycles "$avg")"
    echo "$bits"
    return
  fi
  # Config carries no budget spec (INT/fp16 cells never reach here). Fall back
  # rather than guess a width from the name.
  hybrid_int_bits_legacy_for_cfg "$cfg"
}

model_num_layers() {  # <short>
  case "$1" in
    4B) echo 36 ;;
    llama8B) echo 32 ;;
    14B) echo 40 ;;
    30B) echo 48 ;;
    1.7B) echo 28 ;;
    *) return 1 ;;
  esac
}

auto_hybrid_config() {  # <short> <config> -> path
  local short="$1" cfg="$2"
  local safe_cfg="${cfg//[^A-Za-z0-9_.-]/_}"
  local sens_cfg="${HYBRID_SENS_CONFIG:-$cfg}"
  local safe_sens_cfg="${sens_cfg//[^A-Za-z0-9_.-]/_}"
  local sens_dir="${HYBRID_SENS_DIR:-$TURBO_BASE/sensitivity/_hpca_${TAG}}"
  local sens_json="$sens_dir/${short}_${safe_sens_cfg}_${SENS_METHOD}.json"
  local outdir="$TURBO_BASE/hybrid_configs/_hpca_${TAG}"
  local frac_tag="${HYBRID_INT_FRAC//./p}"
  local out="$outdir/${short}_${safe_cfg}_rank-${safe_sens_cfg}_${SENS_METHOD}_top${frac_tag}.json"
  local layers
  layers="$(model_num_layers "$short")" || return 1
  if [[ ! -s "$sens_json" ]]; then
    echo "[hpca] missing sensitivity JSON for auto hybrid: $sens_json" >&2
    return 1
  fi
  if [[ $DRY -eq 1 ]]; then
    echo "$out"
    return
  fi
  if [[ $DRY -eq 0 ]]; then mkdir -p "$outdir"; fi
  python - "$sens_json" "$out" "$layers" "$HYBRID_INT_FRAC" "$(hybrid_int_bits_for_cfg "$cfg")" <<'PY'
import json
import math
import sys

sens_path, out_path, layers_s, frac_s, bits_s = sys.argv[1:6]
num_layers = int(layers_s)
frac = float(frac_s)
bits = int(bits_s)
if not (0.0 <= frac <= 1.0):
    raise SystemExit(f"hybrid fraction must be in [0,1], got {frac}")

with open(sens_path) as f:
    sens = json.load(f)

layer_buckets = int(sens.get("layer_buckets", 1))
backend = f"int{bits}"
schedule = {}
candidates = []

if "swap_gain" in sens:
    # int_swap (v18): score = measured ΔLoss of putting THIS (op, layer) on INT
    # instead of SC, at the deployed operating point. Native per-layer, ranked
    # descending (largest gain = best INT candidate). This is the criterion the
    # mask actually decides; the branch below ranks by SC precision-fragility
    # and only coincides with it when INT is lossless.
    if int(sens.get("measurement", {}).get("int_bits", bits)) != bits:
        raise SystemExit(
            f"int_swap ranking was measured at int"
            f"{sens['measurement']['int_bits']} but this config masks at int{bits} "
            "— re-measure, do not reuse across widths")
    # Robust sweeps retain the raw mean in swap_gain for interpretation, but
    # select using their uncertainty-aware score.  Old v18 JSONs have no
    # selection_score and remain byte-for-byte on the mean-gain path.
    score_map = sens.get("selection_score", sens["swap_gain"])
    for key, gain in score_map.items():
        op, bpart = key.split(":")
        candidates.append((float(gain), op, int(bpart[1:]), key))
    score_method = sens.get("measurement", {}).get("ranking", {}).get(
        "score_method", "mean")
    selection_method = ("top_fraction_by_int_swap_gain" if score_method == "mean"
                        else f"top_fraction_by_int_swap_{score_method}")
else:
    for key, rec in sens.get("buckets", {}).items():
        op, _t, lpart = key.split(":")
        l_bucket = int(lpart[1:])
        errs = [float(x) for x in rec.get("level_mean_error", [])]
        if len(errs) < 2:
            continue
        worst = max(errs[1:])
        blocks = [
            b for b in range(num_layers)
            if min(layer_buckets - 1, (b * layer_buckets) // max(num_layers, 1)) == l_bucket
        ]
        for block in blocks:
            candidates.append((worst, op, block, key))
    selection_method = "top_fraction_by_bucket_worst_delta_loss"

target = int(math.ceil(len(candidates) * frac))
chosen = sorted(candidates, key=lambda x: x[0], reverse=True)[:target]
for _score, op, block, _key in chosen:
    row = schedule.setdefault(op, ["sc"] * num_layers)
    row[block] = backend

payload = {
    "format": "scmp_llm_hybrid_v1",
    "default": "sc",
    "int_bits": bits,
    "int_sym": True,
    "chunk_size": 128,
    "source_sensitivity": sens_path,
    "selection": {
        "method": selection_method,
        "fraction": frac,
        "selected_entries": len(chosen),
        "total_entries": len(candidates),
        "selected_fraction": (len(chosen) / len(candidates)) if candidates else 0.0,
        "split_half_top_overlap": sens.get("split_half", {}).get("top_overlap"),
        "cross_fold_mean_top_overlap": sens.get("cross_fold", {}).get(
            "mean_top_overlap"),
        "cross_fold_min_top_overlap": sens.get("cross_fold", {}).get(
            "min_top_overlap"),
    },
    "schedule": schedule,
}
with open(out_path, "w") as f:
    json.dump(payload, f, indent=2, sort_keys=True)
print(out_path)
PY
}

sensitivity_budget_for_cfg() {  # <config> -> "levels ratio ref"
  local cfg="$1"
  case "$cfg" in
    sc_int8)   echo "128,96,64 1.0 128" ;;
    sc_avg192) echo "128,96,64 0.75 128" ;;
    sc_int7)   echo "128,64,32 0.5 128" ;;
    sc_avg96)  echo "64,48,32 0.75 64" ;;
    sc_int6)   echo "64,48,32 0.5 64" ;;
    *)
      echo "[hpca] sensitivity only understands sc_* budget configs, got $cfg" >&2
      return 1
      ;;
  esac
}

mp_budget_for_cfg() {  # <config> -> "levels ratio ref"
  local cfg="$1"
  case "$cfg" in
    mp_avg96_burst128|mp_len192|mp_avg192) echo "128,96,64 0.75 128" ;;
    mp_avg64_burst128|mp_int7|mp)          echo "128,64,32 0.5 128" ;;
    mp_avg48_burst128|mp_len96_burst)      echo "128,64,32 0.375 128" ;;
    # v3 fine ladders (pow2-vs-fine ablation partners of avg64/avg48):
    mp_avg64f_burst128)                    echo "128,96,64,48,32 0.5 128" ;;
    mp_avg48f_burst128)                    echo "128,96,64,48,32 0.375 128" ;;
    # final-recipe avg96 (fine ladder at the mild budget, for the ONE-algorithm
    # paper sweep — the old mp_avg96_burst128 is the v2-era pow2 ladder):
    mp_avg96f_burst128)                    echo "128,96,64,48,32 0.75 128" ;;
    # avg32 point: 128 kept (burst ceiling), ladder extended below 32.
    mp_avg32_burst128)                     echo "128,64,48,32,16 0.25 128" ;;
    # v9 int6-only ladder: sell the 128 ceiling, add a 24-cycle bridge, and
    # optimize squared precision-induced degradation (act_global_v9).
    mp_avg32_v9)                           echo "96,64,48,32,24,16 0.25 128" ;;
    # v9 ladder at the 36/40 budget rungs (hybrid-mask dose sweep 2026-07-18).
    mp_avg36_v9)                           echo "96,64,48,32,24,16 0.28125 128" ;;
    mp_avg40_v9)                           echo "96,64,48,32,24,16 0.3125 128" ;;
    # v4 floor-breaking ladders — REFUTED (sub-32 rung toxic under the sigma
    # objective; do not rerun): kept only so old tags stay reproducible.
    mp_avg64x_burst128)                    echo "128,96,64,48,32,16 0.5 128" ;;
    mp_avg48x_burst128)                    echo "128,96,64,48,32,16 0.375 128" ;;
    # v8-E granularity ladders (candidate E, verdict: not refuted 2026-07-13).
    # g = +56 mid-rung only (unambiguously above the ~48 cliff — launchable);
    # h = +56 and +40 (40 needs user sign-off: 'no rungs below the cliff'
    # letter vs 'no rungs below the 32 floor' practice — do not launch h
    # without explicit approval).
    mp_avg48g_burst128)                    echo "128,96,64,56,48,32 0.375 128" ;;
    mp_avg48h_burst128)                    echo "128,96,64,56,48,40,32 0.375 128" ;;
    *)
      echo "[hpca] unknown MP config: $cfg" >&2
      return 1
      ;;
  esac
}

sc_cycles_for_cfg() {  # <config> -> uniform halved-space cycle count
  local cfg="$1"
  case "$cfg" in
    sc_int8)   echo 128 ;;
    sc_avg192) echo 96 ;;
    sc_int7)   echo 64 ;;
    sc_avg96)  echo 48 ;;
    sc_int6)   echo 32 ;;
    *)
      echo "[hpca] unknown SC config: $cfg" >&2
      return 1
      ;;
  esac
}

safe_hf() {
  echo "$1" | tr '/:' '__'
}

run_sensitivity() {  # <short> <hf> <config>
  local short="$1" hf="$2" cfg="$3"
  local spec levels ratio ref layer_buckets
  # int_swap is measured at the DEPLOYED budget, so it also accepts the mp_*
  # driver configs (sensitivity_budget_for_cfg only knows the sc_* ladders).
  if ! spec="$(sensitivity_budget_for_cfg "$cfg" 2>/dev/null)"; then
    if [[ "$SENS_METHOD" == "int_swap" ]]; then
      spec="$(mp_budget_for_cfg "$cfg")" || { fail_cell "$short" "$cfg" sensitivity "bad_cfg"; return; }
    else
      sensitivity_budget_for_cfg "$cfg" >/dev/null   # re-emit the error message
      fail_cell "$short" "$cfg" sensitivity "bad_cfg"; return
    fi
  fi
  read -r levels ratio ref <<<"$spec"
  case "$SENS_LAYER_BUCKETS" in
    auto|layer|layers|per-layer|per_layer) layer_buckets="$(model_num_layers "$short")" ;;
    *) layer_buckets="$SENS_LAYER_BUCKETS" ;;
  esac
  # int_swap ranks a BACKEND swap, so it is measured per-layer at the deployed
  # floor and needs no bucketing; the ladder args stay only to keep one code
  # path (min(levels) is the default reference level).
  local swap_args=()
  if [[ "$SENS_METHOD" == "int_swap" ]]; then
    layer_buckets="$(model_num_layers "$short")"
    swap_args=(
      --int-swap-ref "$INT_SWAP_REF"
      --int-swap-bits "$(hybrid_int_bits_for_cfg "$cfg")"
      --int-swap-window-sampling "$INT_SWAP_WINDOW_SAMPLING"
      --int-swap-score "$INT_SWAP_SCORE"
      --int-swap-lcb-z "$INT_SWAP_LCB_Z"
      --int-swap-stability-folds "$INT_SWAP_STABILITY_FOLDS"
      --seed "$MP_SEED"
    )
    [[ -n "$INT_SWAP_REF_LEVEL" ]] && swap_args+=(--int-swap-ref-level "$INT_SWAP_REF_LEVEL")
    [[ -n "$INT_SWAP_MP_CONFIG" ]] && swap_args+=(--int-swap-mp-config "$INT_SWAP_MP_CONFIG")
    [[ -n "$INT_SWAP_CHECKPOINT" ]] && swap_args+=(--int-swap-checkpoint "$INT_SWAP_CHECKPOINT")
  fi
  local outbase="${SENS_OUTDIR:-$TURBO_BASE/sensitivity/_hpca_${TAG}}"
  local safe_cfg="${cfg//[^A-Za-z0-9_.-]/_}"
  local out="$outbase/${short}_${safe_cfg}_${SENS_METHOD}.json"
  local log="$OUTDIR/${short}_${safe_cfg}_${SENS_METHOD}_sensitivity.log"
  echo "[hpca] >>> Sensitivity $short / $cfg ($SENS_METHOD levels=$levels ratio=$ratio ref=$ref layer_buckets=$layer_buckets) -> $out"
  if [[ $DRY -eq 1 ]]; then
    echo "  DRY: MODEL_PATH=$hf python benchmark/ppl/calibrate_mp_thresholds.py --layer_buckets $layer_buckets --cross-layer-weight $SENS_METHOD --mp_levels $levels --budget_ratio $ratio --budget_ref_stoc_len $ref --measure-windows $SENS_WINDOWS --measure-ctx $SENS_CTX ${swap_args[*]} --output_json $out"
    return
  fi
  mkdir -p "$outbase"
  env MODEL_PATH="$hf" SQ_ALPHA="$SQ_ALPHA" ACT_SCALES_DIR="$ACT_SCALES_DIR" \
      SC_OWEN_MODE="$SC_OWEN_MODE" SC_SCRAMBLE_MASKS="$SC_SCRAMBLE_MASKS" \
      python -u "$HERE/benchmark/ppl/calibrate_mp_thresholds.py" \
        --model_path "$hf" \
        --sc_prec 8 --halve 1 \
        --mp_levels "$levels" \
        --budget_ratio "$ratio" \
        --budget_ref_stoc_len "$ref" \
        --layer_buckets "$layer_buckets" \
        --budget-scope global \
        --cross-layer-weight "$SENS_METHOD" \
        --num_calib_sequences "$SENS_CALIB_SEQS" \
        --ctx_len "$PPL_CTX" \
        --calib-smoothquant \
        --measure-windows "$SENS_WINDOWS" \
        --measure-ctx "$SENS_CTX" \
        "${swap_args[@]}" \
        --output_json "$out" \
        2>&1 | tee "$log"
  local rc="${PIPESTATUS[0]}"
  if [[ $rc -eq 0 && -s "$out" ]]; then
    record "$short" "$cfg" sensitivity "$out"
  else
    fail_cell "$short" "$cfg" sensitivity "rc=$rc, no output"
  fi
}

run_ppl() {  # <short> <hf> <config>
  local short="$1" hf="$2" cfg="$3"
  if [[ "$cfg" == mp || "$cfg" == mp_* ]]; then
    run_mp_ppl "$short" "$hf" "$cfg"
    return
  fi
  local log="$OUTDIR/${short}_${cfg}_ppl.log"
  # SC cells also emit the scmp_kernels precision trace — the execution log
  # (per-(op,block) calls/rows/macs/row_cycles) the energy/latency simulator
  # consumes. Summary mode by default (SC_MP_TRACE_MODE=trace for per-call
  # JSONL); durable deliverable -> Turbo. SC_TRACE=0 disables. Empty
  # SC_MP_TRACE keeps tracing off for INT cells (env-driven enable ignores "").
  local trace=""
  if [[ "$cfg" == sc_* && "${SC_TRACE:-1}" == "1" ]]; then
    trace="$TURBO_BASE/traces/_hpca_${TAG}/${short}_${cfg}_trace.json"
    [[ $DRY -eq 0 ]] && mkdir -p "$(dirname "$trace")"
  fi
  echo "[hpca] >>> PPL  $short / $cfg -> $log"
  local hybrid_env=()
  if [[ "$SC_BACKEND" == "hybrid" ]] && is_sc_like_cfg "$cfg"; then
    local hybrid_config="$HYBRID_CONFIG_JSON"
    if [[ -z "$hybrid_config" ]]; then
      hybrid_config="$(auto_hybrid_config "$short" "$cfg")" || {
        fail_cell "$short" "$cfg" ppl "auto hybrid config failed"
        return
      }
    fi
    if [[ -z "$hybrid_config" ]]; then
      fail_cell "$short" "$cfg" ppl "--sc-backend hybrid requires --hybrid-config or sensitivity JSON"
      return
    fi
    hybrid_env=(
      SC_HYBRID_CONFIG_JSON="$hybrid_config"
      SC_HYBRID_INT_BITS="$(hybrid_int_bits_for_cfg "$cfg")"
      SC_HYBRID_FORCE_INT_BITS=1
    )
  fi
  [[ $DRY -eq 1 ]] && { echo "  DRY: MODEL_PATH=$hf QUANT_CONFIG=$cfg SC_MP_TRACE=$trace ${hybrid_env[*]} python benchmark/quant/eval_quant.py"; return; }
  env MODEL_PATH="$hf" QUANT_CONFIG="$cfg" SQ_ALPHA="$SQ_ALPHA" \
      PPL_MAX_TOKENS="$PPL_MAX_TOKENS" CTX="$PPL_CTX" \
      SC_OWEN_MODE="$SC_OWEN_MODE" SC_SCRAMBLE_MASKS="$SC_SCRAMBLE_MASKS" \
      SC_MP_TRACE="$trace" SC_MP_TRACE_MODE="${SC_MP_TRACE_MODE:-summary}" \
      "${hybrid_env[@]}" \
      python -u "$HERE/benchmark/quant/eval_quant.py" 2>&1 | tee "$log"
  local rc="${PIPESTATUS[0]}"
  # capture finite PPL AND nan/inf (a collapsed config is a real result)
  local v; v=$(grep "\[RESULT\]" "$log" | grep -oE "value=[^ ]+" | sed 's/value=//' | tail -1)
  if [[ -n "$v" ]]; then
    record "$short" "$cfg" ppl "$v"
  else
    fail_cell "$short" "$cfg" ppl "rc=$rc, no [RESULT] in log"
  fi
}

run_mp_ppl() {  # <short> <hf> <mp_config>
  local short="$1" hf="$2" cfg="$3"
  local spec levels ratio ref
  if [[ "$MP_METHOD" == "act_global_v9" && ! "$cfg" =~ ^mp_avg(32|36|40)_v9$ ]]; then
    fail_cell "$short" "$cfg" ppl "act_global_v9 pairs only with mp_avg{32,36,40}_v9"
    return
  fi
  if [[ "$cfg" =~ ^mp_avg(32|36|40)_v9$ && "$MP_METHOD" != "act_global_v9" ]]; then
    fail_cell "$short" "$cfg" ppl "$cfg requires --mp-method act_global_v9"
    return
  fi
  spec="$(mp_budget_for_cfg "$cfg")" || { fail_cell "$short" "$cfg" ppl "bad_mp_cfg"; return; }
  read -r levels ratio ref <<<"$spec"

  local hybrid_env=()
  local hybrid_config=""
  if [[ "$SC_BACKEND" == "hybrid" ]]; then
    hybrid_config="$HYBRID_CONFIG_JSON"
    if [[ -z "$hybrid_config" ]]; then
      hybrid_config="$(auto_hybrid_config "$short" "$cfg")" || {
        fail_cell "$short" "$cfg" ppl "auto hybrid config failed"
        return
      }
    fi
    hybrid_env=(
      SC_HYBRID_CONFIG_JSON="$hybrid_config"
      SC_HYBRID_INT_BITS="$(hybrid_int_bits_for_cfg "$cfg")"
      SC_HYBRID_FORCE_INT_BITS=1
    )
  fi

  local tables="${MP_TABLES_DIR:-$TURBO_BASE/mp_calib_${TAG}}"
  local sm safe_cfg method table wrapper log trace protect_flags
  sm="$(safe_hf "$hf")"
  safe_cfg="${cfg//[^A-Za-z0-9_.-]/_}"
  method="${MP_METHOD}"
  if [[ "$MP_PROTECT_FRAC" != "0" && "$MP_PROTECT_FRAC" != "0.0" ]]; then
    method="${method}_pc${MP_PROTECT_FRAC}x${MP_PROTECT_STOC_LEN}_${MP_PROTECT_METRIC}"
    [[ "$MP_PROTECT_COMPENSATE" == "1" ]] && method="${method}_comp"
  fi
  if [[ -n "$MP_PROTECT_FRAC_OVERRIDES" ]]; then
    method="${method}_pcov${MP_PROTECT_FRAC_OVERRIDES//[^A-Za-z0-9]/_}"
  fi
  if [[ -n "$SQ_ALPHA_OVERRIDES" ]]; then
    method="${method}_sqov${SQ_ALPHA_OVERRIDES//[^A-Za-z0-9]/_}"
  fi
  [[ "$SC_BACKEND" == "hybrid" ]] && method="${method}_hyb${HYBRID_INT_FRAC}"
  table="$tables/${sm}__${safe_cfg}__${method}.json"
  wrapper="$tables/${sm}__${safe_cfg}__${method}_wrapper.json"
  log="$OUTDIR/${short}_${safe_cfg}_${method}_ppl.log"
  trace="/home/allenjin/Projects/hpca_results/llm/uniform/traces/${short}_sc_int7_trace.json"

  protect_flags=()
  if [[ "$MP_PROTECT_FRAC" != "0" && "$MP_PROTECT_FRAC" != "0.0" ]]; then
    protect_flags=(
      --protect-channel-frac "$MP_PROTECT_FRAC"
      --protect-channel-stoc-len "$MP_PROTECT_STOC_LEN"
      --protect-channel-metric "$MP_PROTECT_METRIC"
    )
    [[ -n "$MP_PROTECT_FRAC_OVERRIDES" ]] && protect_flags+=(--protect-channel-frac-overrides "$MP_PROTECT_FRAC_OVERRIDES")
    protect_flags+=(
    )
    [[ "$MP_PROTECT_COMPENSATE" == "1" ]] && protect_flags+=(--protect-compensate-budget)
  fi

  local v2_flags=()
  if [[ "$MP_METHOD" == "act_global_v2" ]]; then
    v2_flags=(--argmin-pricing macs --metric-select auto)
  elif [[ "$MP_METHOD" == "act_global_v3" ]]; then
    # v2 + MAC-consistent residual greedy fill (spends the ~1% budget the
    # discrete argmin leaves unspent on the best Δσ/Δprice rows).
    v2_flags=(--argmin-pricing macs --metric-select auto --refine sigma)
  elif [[ "$MP_METHOD" == "act_global_v3m" ]]; then
    v2_flags=(--argmin-pricing macs --metric-select auto --refine sigma
              --cross-layer-weight measured)
  elif [[ "$MP_METHOD" == "act_global_v3s" ]]; then
    # v3 + squared-error (sigma2) objective: per-row cliff-aware surrogate.
    v2_flags=(--argmin-pricing macs --metric-select auto --refine sigma
              --objective sigma2)
  elif [[ "$MP_METHOD" == "act_global_v3c" ]]; then
    # v3 + measured per-level dLoss curve. The curve method auto-enables its own
    # MAC-priced residual budget fill (_curve_applied) so --refine is omitted.
    v2_flags=(--argmin-pricing macs --metric-select auto
              --cross-layer-weight measured_curve)
  elif [[ "$MP_METHOD" == "act_global_v9" ]]; then
    # V9: objective-consistent residual fill over squared precision-induced
    # degradation. Lambda/argmin/metric/fill share one objective transform.
    v2_flags=(--argmin-pricing macs --metric-select auto --refine sigma
              --objective delta_sigma2)
  fi

  echo "[hpca] >>> MP-PPL $short / $cfg ($method levels=$levels ratio=$ratio hybrid=${hybrid_config:-none}) -> $log"
  if [[ $DRY -eq 1 ]]; then
    echo "  DRY: ${hybrid_env[*]} python benchmark/ppl/calibrate_mp_thresholds.py --mp_levels $levels --budget_ratio $ratio --budget-weight macs --mac-weights-trace $trace ${protect_flags[*]} ${v2_flags[*]} --output_json $table"
    echo "  DRY: MP_CONFIG_JSON=$wrapper ${hybrid_env[*]} QUANT_CONFIG=mp python benchmark/quant/eval_quant.py"
    return
  fi

  mkdir -p "$tables"
  {
    echo "=== MP CELL $short $cfg method=$method $(date) ==="
    echo "levels=$levels ratio=$ratio ref=$ref hybrid=${hybrid_config:-none}"
    echo "table=$table"
    env SQ_ALPHA="$SQ_ALPHA" SQ_ALPHA_OVERRIDES="$SQ_ALPHA_OVERRIDES" \
        ACT_SCALES_DIR="$ACT_SCALES_DIR" \
        SC_OWEN_MODE="$SC_OWEN_MODE" SC_SCRAMBLE_MASKS="$SC_SCRAMBLE_MASKS" \
        "${hybrid_env[@]}" \
        python -u "$HERE/benchmark/ppl/calibrate_mp_thresholds.py" \
          --model_path "$hf" \
          --mp_levels "$levels" \
          --budget_ratio "$ratio" \
          --budget_ref_stoc_len "$ref" \
          --sc_prec 8 --halve 1 \
          --seed "$MP_SEED" \
          --ctx_len "$PPL_CTX" \
          --budget-scope global \
          --budget-weight macs \
          --mac-weights-trace "$trace" \
          --calib-smoothquant \
          "${protect_flags[@]}" \
          "${v2_flags[@]}" \
          --output_json "$table"
    local rc="${PIPESTATUS[0]}"
    if [[ $rc -ne 0 || ! -s "$table" ]]; then
      echo "CALIB_FAILED rc=$rc"
      exit 21
    fi
    python -c "import json;json.dump({'type':'AdaptiveMPConfig','stoc_len_levels':[int(x) for x in '$levels'.split(',')],'threshold_table_path':'$table'},open('$wrapper','w'))"
    env MODEL_PATH="$hf" QUANT_CONFIG=mp SQ_ALPHA="$SQ_ALPHA" \
        SQ_ALPHA_OVERRIDES="$SQ_ALPHA_OVERRIDES" \
        PPL_MAX_TOKENS="$PPL_MAX_TOKENS" CTX="$PPL_CTX" \
        SC_OWEN_MODE="$SC_OWEN_MODE" SC_SCRAMBLE_MASKS="$SC_SCRAMBLE_MASKS" \
        MP_CONFIG_JSON="$wrapper" ACT_SCALES_DIR="$ACT_SCALES_DIR" \
        SC_MP_TRACE="$tables/${sm}__${safe_cfg}__${method}_trace.json" \
        SC_MP_TRACE_MODE="${SC_MP_TRACE_MODE:-summary}" \
        "${hybrid_env[@]}" \
        python -u "$HERE/benchmark/quant/eval_quant.py"
  } 2>&1 | tee "$log"

  local rc="${PIPESTATUS[0]}"
  local ppl avg flop exp
  ppl=$(grep "\[RESULT\]" "$log" | grep -oE "value=[^ ]+" | sed 's/value=//' | tail -1)
  avg=$(grep "\[RESULT\]" "$log" | grep -oE "realized_avg_sl=[0-9.]+" | sed 's/realized_avg_sl=//' | tail -1)
  flop=$(grep "\[RESULT\]" "$log" | grep -oE "realized_flop_avg_sl=[0-9.]+" | sed 's/realized_flop_avg_sl=//' | tail -1)
  exp=$(python -c "import json;print(round(json.load(open('$table')).get('expected_flop_avg_stoc_len',0),4))" 2>/dev/null)
  if [[ -n "$ppl" ]]; then
    record "$short" "$cfg" ppl "$ppl"
    [[ -n "$avg" ]] && record "$short" "$cfg" mp_realized_avg_sl "$avg"
    [[ -n "$flop" ]] && record "$short" "$cfg" mp_realized_flop_avg_sl "$flop"
    [[ -n "$exp" ]] && record "$short" "$cfg" mp_expected_flop_avg_sl "$exp"
    record "$short" "$cfg" mp_table "$table"
    [[ -n "$hybrid_config" ]] && record "$short" "$cfg" hybrid_config "$hybrid_config"
  else
    fail_cell "$short" "$cfg" ppl "rc=$rc, no [RESULT] in log"
  fi
}

# LongBench uses a REGISTERED key from config/model2path.json (+ model2maxlen.json),
# NOT the HF id, and its argparsers accept dtype fp16|bf16 (NOT float16).
# Registered today: qwen3-4b, llama-3.1-8b. To enable 14B/30B, add them to BOTH
# json files, then map short->key here. Unmapped models are skipped.
declare -A LONGBENCH_NAME=(
  [4B]="qwen3-4b"
  [llama8B]="llama-3.1-8b"
)
run_longbench() {  # <short> <hf> <config>
  local short="$1" hf="$2" cfg="$3"
  [[ "$cfg" == sc_* ]] && { echo "[hpca] [skip] LongBench $short/$cfg — SC cells are ppl-only"; return; }
  local lbname="${LONGBENCH_NAME[$short]:-}"
  [[ -z "$lbname" ]] && { echo "[hpca] [skip] LongBench $short/$cfg — '$short' not registered in benchmark/LongBench/config/model2path.json"; return; }
  local mode="fp16"; [[ "$cfg" != "fp16" ]] && mode="quant"
  echo "[hpca] >>> LongBench  $short ($lbname) / $cfg (mode=$mode)"
  [[ $DRY -eq 1 ]] && { echo "  DRY: QUANT_CONFIG=$cfg bash benchmark/LongBench/longbench_run.sh $lbname $mode fp16 cuda:0"; return; }
  ( cd "$HERE/benchmark/LongBench" && QUANT_CONFIG="$cfg" \
      bash longbench_run.sh "$lbname" "$mode" fp16 cuda:0 ) 2>&1 \
      | tee "$OUTDIR/${short}_${cfg}_longbench.log"
  # score lives in results/pred/<key>/<tag>/result.json — average it
  local tag="fp16"; [[ "$cfg" != "fp16" ]] && tag="quant_${cfg}"
  local rj="$HERE/benchmark/LongBench/results/pred/${lbname}/${tag}/result.json"
  local v; v=$(python -c "import json,sys;d=json.load(open('$rj'));print(round(sum(d.values())/len(d),4))" 2>/dev/null)
  if [[ -n "$v" ]]; then
    record "$short" "$cfg" longbench "$v"
  else
    fail_cell "$short" "$cfg" longbench "no parsable $rj"
  fi
}

# RULER uses a REGISTERED model name (ruler_config_models.sh), NOT the HF id.
# All five below are registered in ruler_config_models.sh. ruler_run.sh args:
#   MODEL_NAME(1) BENCHMARK(2) MAX_SEQ(3) TASK(4) MODE(5) DTYPE(6) DEVICE(7)
declare -A RULER_NAME=(
  [1.7B]="qwen3-1.7b"
  [4B]="qwen3-4b"
  [14B]="qwen3-14b"
  [30B]="qwen3-30b-a3b"
  [llama8B]="llama-3.1-8b"
)
RULER_MAXSEQ="${RULER_MAXSEQ:-4096}"
RULER_TASK="${RULER_TASK:-niah_single_1}"   # single task; loop externally for full RULER
run_ruler() {  # <short> <hf> <config>
  local short="$1" hf="$2" cfg="$3"
  local rname="${RULER_NAME[$short]:-}"
  [[ -z "$rname" ]] && { echo "[hpca] [skip] RULER $short/$cfg — no ruler_config_models.sh name mapped for '$short'"; return; }
  local mode="fp16" stoc_len="" tag_suffix="" tagdir="fp16"
  local hybrid_env=()
  if [[ "$cfg" == sc_* ]]; then
    mode="sc"
    stoc_len="$(sc_cycles_for_cfg "$cfg")" || { fail_cell "$short" "$cfg" ruler "bad_sc_cfg"; return; }
    tag_suffix="_${cfg}"
    if [[ "$SC_BACKEND" == "hybrid" ]]; then
      local hybrid_config="$HYBRID_CONFIG_JSON"
      if [[ -z "$hybrid_config" ]]; then
        hybrid_config="$(auto_hybrid_config "$short" "$cfg")" || {
          fail_cell "$short" "$cfg" ruler "auto hybrid config failed"
          return
        }
      fi
      tag_suffix="${tag_suffix}_hyb${HYBRID_INT_FRAC}"
      hybrid_env=(
        SC_HYBRID_CONFIG_JSON="$hybrid_config"
        SC_HYBRID_INT_BITS="$(hybrid_int_bits_for_cfg "$cfg")"
        SC_HYBRID_FORCE_INT_BITS=1
      )
    fi
    tagdir="sc_prec8_stoc${stoc_len}_gran-per_row${tag_suffix}"
  elif [[ "$cfg" != "fp16" ]]; then
    mode="quant"
    tagdir="quant_${cfg}"
  fi
  echo "[hpca] >>> RULER  $short ($rname) / $cfg (mode=$mode, task=$RULER_TASK)"
  if ! grep -q "\b${rname})" "$HERE/benchmark/ruler/ruler_config_models.sh" 2>/dev/null; then
    echo "  [skip] '$rname' not registered in ruler_config_models.sh — register it first."; return
  fi
  # DTYPE=fp16 (the argparsers accept fp16|bf16, NOT float16).
  # SC_ATTN_GRANULARITY=per_row: ruler_run.sh forwards it to call_api.py for
  # every mode, and benchmark/config.py now only permits per_row — its default
  # (per_head) would be rejected in argparse before the model even loads.
  [[ $DRY -eq 1 ]] && { echo "  DRY: QUANT_CONFIG=$cfg RULER_TAG_SUFFIX=$tag_suffix SC_STOC_LEN=${stoc_len:-256} ${hybrid_env[*]} bash ruler_run.sh $rname synthetic $RULER_MAXSEQ $RULER_TASK $mode fp16 cuda:0 8 ${stoc_len:-256}"; return; }
  ( cd "$HERE/benchmark/ruler" && env QUANT_CONFIG="$cfg" SQ_ALPHA="$SQ_ALPHA" \
      SC_ATTN_GRANULARITY=per_row SC_HALVE_BIPOLAR_STOC_LEN=1 \
      SC_OWEN_MODE="$SC_OWEN_MODE" SC_SCRAMBLE_MASKS="$SC_SCRAMBLE_MASKS" \
      RULER_TAG_SUFFIX="$tag_suffix" \
      "${hybrid_env[@]}" \
      bash ruler_run.sh "$rname" synthetic "$RULER_MAXSEQ" "$RULER_TASK" "$mode" fp16 cuda:0 8 "${stoc_len:-256}" ) 2>&1 \
      | tee "$OUTDIR/${short}_${cfg}_ruler.log"
  # Summary: ruler_eval_result/<name>/synthetic/<maxseq>/<tag>/pred/
  # summary-<task>.csv (tag=fp16 or quant_<cfg>). Rows are Tasks/Score/Nulls —
  # read the Score row explicitly. (The old glob missed the /pred/ level and the
  # fp16 tag, and `tail -1` grabbed the Nulls value instead of the score.)
  local sumdir="$HERE/benchmark/ruler/ruler_eval_result/${rname}/synthetic/${RULER_MAXSEQ}/${tagdir}/pred"
  local scsv="$sumdir/summary-${RULER_TASK}.csv"; [[ -f "$scsv" ]] || scsv="$sumdir/summary.csv"
  local v; v=$(python3 - "$scsv" <<'PYEOF'
import csv, sys
try:
    rows = list(csv.reader(open(sys.argv[1])))
except Exception:
    sys.exit(0)
for r in rows:
    if r and r[0].strip().lower() == "score":
        vals = [float(x) for x in r[1:] if x.strip().lower() not in ("", "nan")]
        if vals:
            print(round(sum(vals) / len(vals), 4))
        break
PYEOF
)
  if [[ -n "$v" ]]; then
    record "$short" "$cfg" ruler "$v"
  else
    fail_cell "$short" "$cfg" ruler "no Score row in $scsv"
  fi
}

# Width diagnostic: `bash hpca --print-int-bits mp_avg32_v9` prints the mask
# width this config would use, without running anything. Also the test hook.
if [[ -n "$PRINT_INT_BITS_CYCLES" ]]; then
  [[ "$PRINT_INT_BITS_CYCLES" =~ ^[0-9]+$ ]] \
    && (( PRINT_INT_BITS_CYCLES > 0 )) \
    || { echo "--print-int-bits-cycles requires a positive integer" >&2; exit 2; }
  iso_int_bits_for_cycles "$PRINT_INT_BITS_CYCLES"
  exit 0
fi
if [[ -n "${PRINT_INT_BITS:-}" ]]; then
  hybrid_int_bits_for_cfg "$PRINT_INT_BITS"
  exit 0
fi

for SHORT in "${MODELS[@]}"; do
  HF="${MODEL_ID[$SHORT]:-}"
  [[ -z "$HF" ]] && { echo "[skip] unknown model '$SHORT'"; continue; }
  for CFG in "${CONFIGS[@]}"; do
    for M in "${METRICS[@]}"; do
      case "$M" in
        ppl)       run_ppl       "$SHORT" "$HF" "$CFG" ;;
        sensitivity) run_sensitivity "$SHORT" "$HF" "$CFG" ;;
        longbench) run_longbench "$SHORT" "$HF" "$CFG" ;;
        ruler)     run_ruler     "$SHORT" "$HF" "$CFG" ;;
        *) echo "[skip] unknown metric '$M'" ;;
      esac
    done
  done
done

if [[ $DRY -eq 0 ]]; then
  echo; echo "===== HPCA baseline summary ($OUTDIR) ====="
  # Dedupe on (model, config, metric) keeping the LAST row: same-day reruns
  # append rather than replace, and the freshest value is the one whose log
  # and trace files are on disk.
  awk -F'\t' 'NR==1{print;next}{k=$1 FS $2 FS $3; if(!(k in row)) order[++n]=k; row[k]=$0} END{for(i=1;i<=n;i++) print row[order[i]]}' \
    "$RESULTS" | column -t -s $'\t'
fi
echo "[hpca] done. results: $RESULTS"
if [[ $N_FAILED -gt 0 ]]; then
  echo "[hpca] WARNING: $N_FAILED cell(s) FAILED — see FAILED(...) rows above."
  exit 1
fi
